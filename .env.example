# Prisma không nhận jdbc:. Cổng trong URL là cổng Postgres, không phải cổng API.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public
JWT_SECRET=doi-chuoi-dai-khi-len-vps
# true chỉ trên máy dev: OTP luôn 000000 và API trả mã về. Trên VPS để false.
OTP_DEV=false
# 127.0.0.1 khi Next và Nest cùng một VPS. 0.0.0.0 chỉ khi máy khác cần gọi nội bộ, rồi chặn firewall.
HOST=127.0.0.1
PORT=3001
# true khi site đã có HTTPS.
COOKIE_SECURE=true
# Chỉ cần khi trình duyệt gọi thẳng host API. Cùng domain qua rewrite của Next thì bỏ dòng này.
# CORS_ORIGIN=https://ten-mien-cua-ban
